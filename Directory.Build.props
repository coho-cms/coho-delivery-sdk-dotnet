<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Documented where a name does not say it all, as in the TypeScript SDK; not member by member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    What every published package carries. The three packages release together at one
    version: the template pins the libraries it creates to it.
  -->
  <PropertyGroup>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Coho CMS</Authors>
    <Company>Coho CMS</Company>
    <Copyright>Copyright Coho CMS</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coho-cms/coho-delivery-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coho-cms/coho-delivery-sdk-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>coho;cms;headless</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- TODO: the embedded icon, PackageIcon, once the PNG is in the repository. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
